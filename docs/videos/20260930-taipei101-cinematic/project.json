    },
    {
      "id": "clip-7-caption-0",
      "clipId": "clip-7",
      "source": "script",
      "text": "바람을 없애는 것도, 건물을\n완전히 멈추는 것도 아닙니다.",
      "startFrame": 0,
      "endFrame": 92,
      "font": "gothic",
      "size": 48,
      "x": 50,
      "y": 50,
      "position": "middle",

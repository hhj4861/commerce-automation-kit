    },
    {
      "id": "clip-6-caption-1",
      "clipId": "clip-6",
      "source": "script",
      "text": "공과 건물 사이의\n움직임에 저항하면서,",
      "startFrame": 67,
      "endFrame": 130,
      "font": "gothic",
      "size": 48,

      "outlineWidth": 0,
      "outlineColor": "#000000"
    },
    {
      "id": "clip-6-caption-3",
      "clipId": "clip-6",
      "source": "script",
      "text": "흔들림에 제동을 거는 겁니다.",
      "startFrame": 183,
      "endFrame": 231,
      "font": "gothic",
      "size": 48,
      "x": 50,
      "y": 50,
      "position": "middle",
      "background": true,

    },
    {
      "id": "clip-8-caption-0",
      "clipId": "clip-8",
      "source": "script",
      "text": "강한 건축은 무조건\n꼼짝하지 않는 건축일까요?",
      "startFrame": 0,
      "endFrame": 78,
      "font": "gothic",
      "size": 48,

    },
    {
      "id": "clip-7-caption-1",
      "clipId": "clip-7",
      "source": "script",
      "text": "건물 구조와 함께\n작동하며 흔들림을 줄이고,",
      "startFrame": 92,
      "endFrame": 161,
      "font": "gothic",

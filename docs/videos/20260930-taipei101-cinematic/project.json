      "color": "#f2efe6",
      "outlineWidth": 0,
      "outlineColor": "#000000"
    },
    {
      "id": "clip-6-caption-2",
      "clipId": "clip-6",
      "source": "script",
      "text": "진동 에너지를 열로 소모시키죠.",
      "startFrame": 130,
      "endFrame": 183,
      "font": "gothic",
      "size": 48,
      "x": 50,
      "y": 50,
      "position": "middle",
      "background": true,

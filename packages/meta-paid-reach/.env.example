# 네트워크 호출에 필요. 실제 값은 저장소 루트 .env 등 gitignored 파일에만 둔다.
META_ACCESS_TOKEN=replace-with-user-or-system-user-token
META_AD_ACCOUNT_ID=act_123456789012345

# 2026-09-04 기준 공식 SDK 최신 주 버전. 앱에서 지원하는 고정 버전으로 명시한다.
META_GRAPH_API_VERSION=v26.0

# 선택: App Secret Proof를 자동 첨부한다. Meta 앱에서 proof 강제를 켠 경우 필요.
# META_APP_SECRET=replace-with-app-secret

# 라이브 집행용 이중 잠금. dry-run/PAUSED 생성에는 설정하지 않는다.
# META_POC_ALLOW_LIVE_SPEND=I_UNDERSTAND
# META_POC_HARD_SPEND_CAP_MINOR=15000

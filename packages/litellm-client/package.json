{
  "name": "@cak/litellm-client",
  "version": "0.4.0",
  "private": true,
  "description": "Server-side LiteLLM transport and platform-scoped connection lifecycle; no shared login required",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./jev": {
      "types": "./jev.d.ts",
      "import": "./jev.mjs",
      "default": "./jev.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md",
    "accounts.mjs",
    "accounts.d.mts",
    "jev.mjs",
    "jev.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}

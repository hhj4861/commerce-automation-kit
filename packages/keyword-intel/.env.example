# 네이버 개발자센터(developers.naver.com) 애플리케이션 등록 후 발급
# 검색 API와 데이터랩 API는 동일 애플리케이션의 Client ID/Secret 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 호출 한도 방어용 — D1 실측 확정(2026-07-23, developers.naver.com 공식 문서 원문 검증)
# 검색 API 통합 일일 한도 25,000/일(client ID별 합산, 초과 시 HTTP 429)에서 안전 마진을 뺀 자체 상한
DAILY_CALL_BUDGET_SEARCH=20000
# 데이터랩 검색어트렌드 일일 한도 1,000/일에서 안전 마진을 뺀 자체 상한
# (쇼핑인사이트도 별도 1,000/일 — 사용 시 별도 예산 변수로 분리할 것)
DAILY_CALL_BUDGET_DATALAB=800

# 로컬 저장소 (기본 SQLite 파일 경로)
DB_PATH=./data/intel.db

# DLQ 격리 임계 — 이 횟수 이상 "연속" 실패한 키워드는 수집에서 격리(failures 로 설명됨)
# ※ 키워드 자체 문제(HTTP 400)만 계상. 401/429/5xx 등 시스템 전역 오류는 DLQ 에 쌓이지 않음
DLQ_THRESHOLD=3
# 격리 쿨다운(시간) — 경과하면 자동으로 1회 재시도 허용(자가 회복). 즉시 해제: npm run dlq -- clear
DLQ_COOLDOWN_HOURS=24

# 동시 요청 수 (네이버 QPS 제약 방어)
MAX_CONCURRENCY=3

# 로그 레벨 (debug|info|warn|error)
LOG_LEVEL=info

# 일일 다이제스트 텔레그램 전송 (선택 — 미설정 시 전송만 생략되고 수집은 정상 동작)
# 1) 텔레그램 @BotFather → /newbot → 토큰을 아래에 직접 입력 (채팅·커밋에 노출 금지)
# 2) 만든 봇에게 아무 메시지 1개 전송 → `npm run report -- --setup` 으로 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

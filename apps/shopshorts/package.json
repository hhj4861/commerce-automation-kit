{
  "name": "@cak/app-shopshorts",
  "version": "0.1.0",
  "private": true,
  "description": "쇼핑쇼츠 통합 운영 앱 — 공용 UI + 로컬 서버/워커 + Cloudflare Pages/Functions/D1/R2.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "worker": "node worker.mjs",
    "llm:worker": "node studio-account-worker.mjs",
    "llm:setup": "python3 -m venv ../../node_modules/.claude-auth-venv && ../../node_modules/.claude-auth-venv/bin/python -m pip install -r requirements-claude.txt",
    "start:cloud-secrets": "node ../credential-broker/runner-bootstrap.mjs server.mjs",
    "worker:cloud-secrets": "node ../credential-broker/runner-bootstrap.mjs worker.mjs",
    "test": "node --test test/*.test.mjs",
    "cloud:dev": "npx wrangler pages dev public",
    "cloud:deploy": "npx wrangler pages deploy public --project-name shopshorts-dash"
  },
  "dependencies": {
    "@higgsfield/cli": "1.1.26",
    "better-sqlite3": "^11.0.0",
    "jose": "6.2.3"
  }
}

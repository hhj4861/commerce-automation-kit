FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ripgrep libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'litellm[proxy]==1.102.1' cryptography
# Unmodified official binary, pinned and installed with Anthropic's installer.
ARG CLAUDE_VERSION=2.1.284
RUN curl -fsSL https://claude.ai/install.sh -o /tmp/install-claude.sh \
    && bash /tmp/install-claude.sh "${CLAUDE_VERSION}" \
    && cp -L /root/.local/bin/claude /usr/local/bin/claude \
    && rm -rf /tmp/install-claude.sh /root/.local /root/.claude
ENV DISABLE_AUTOUPDATER=1
WORKDIR /accounts

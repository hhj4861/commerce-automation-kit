# Run python3 gateway.py init to generate private infrastructure credentials.
# A provider model path is required for each chat route; no provider is selected implicitly.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=
GATEWAY_DOMAIN=localhost
HANMADI_CHAT_MODEL=
HANMADI_CHAT_API_KEY=
HANMADI_CHAT_API_BASE=
REPLAY_CHAT_MODEL=
REPLAY_CHAT_API_KEY=
REPLAY_CHAT_API_BASE=
FESTA_CHAT_MODEL=
FESTA_CHAT_API_KEY=
FESTA_CHAT_API_BASE=
ELEVENLABS_API_KEY=
# Jev pass-through provider key; never distribute to apps or browsers.
# Clients use restricted LiteLLM virtual keys and /typesafe/v1/systemone.
TYPESAFE_API_KEY=

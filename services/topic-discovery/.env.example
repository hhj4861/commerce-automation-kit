# Provision through the existing Cloudflare secret manager; no real values in Git.
DISCOVERY_DB=/discovery-data/discovery.sqlite
DISCOVERY_PLATFORM_KEYS={}
DISCOVERY_REQUESTS_PER_DAY=30
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
JEV_BASE_URL=https://YOUR-SHARED-HOST/llm
JEV_API_KEY=
# Existing workers only; never public browser variables:
DISCOVERY_ENABLED=0
DISCOVERY_URL=https://YOUR-SHARED-HOST/discovery
DISCOVERY_API_KEY=
DISCOVERY_SUBJECT=

# Shopshorts account worker opt-in after matching service/worker deployment:
# DISCOVERY_WORKFLOW=research-v2
# DISCOVERY_REVIEW_MODE=native-llm-v1
# Leave review mode unset to retain the two-stage research flow.

{
    admin off
    auto_https off
}
:8080 {
    @llm path /llm/v1/models /llm/v1/chat/completions /llm/v1/responses /llm/v1/embeddings /llm/v1/audio/speech /llm/v1/audio/transcriptions
    handle @llm {
        uri strip_prefix /llm
        reverse_proxy 127.0.0.1:4100 {
            flush_interval -1
        }
    }
    # Only Hanmadi video analysis uses native Gemini; other models remain closed.
    @hanmadiVideo {
        method POST
        path /llm/v1beta/models/hanmadi-chat:generateContent
    }
    handle @hanmadiVideo {
        uri strip_prefix /llm
        reverse_proxy 127.0.0.1:4100
    }
    @jev {
        method POST
        path /llm/typesafe/v1/systemone
    }
    handle @jev {
        uri strip_prefix /llm
        reverse_proxy 127.0.0.1:4100
    }
    @discoveryWrite {
        method POST
        path_regexp discoveryWrite ^/discovery/v1/discover(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/(claim|complete))?$
    }
    handle @discoveryWrite {
        uri strip_prefix /discovery
        reverse_proxy 127.0.0.1:4195
    }
    @discoveryRead {
        method GET
        path_regexp discoveryRead ^/discovery/v1/discover/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$
    }
    handle @discoveryRead {
        uri strip_prefix /discovery
        reverse_proxy 127.0.0.1:4195
    }
    @accounts path /accounts/connections /accounts/connections/* /accounts/v1/chat/completions
    handle @accounts {
        uri strip_prefix /accounts
        reverse_proxy 127.0.0.1:4190
    }
    @dify path /v1/chat-messages /v1/workflows/run
    handle @dify {
        reverse_proxy 127.0.0.1:4180 {
            flush_interval -1
        }
    }
    handle /health {
        respond "edge alive" 200
    }
    handle {
        respond "Not found" 404
    }
}
